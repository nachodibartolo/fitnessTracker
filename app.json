{
  "expo": {
    "name": "fitnessTracker",
    "slug": "fitnessTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitnessTracker",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dibague.fitnessTracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para estimar las calorías de tus comidas.",
          "cameraPermission": "La app usa la cámara para sacarle una foto a tu comida y estimar sus calorías."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "La app lee tus pasos, calorías, frecuencia cardíaca en reposo y peso de Apple Health para mostrarlos en tu panel.",
          "NSHealthUpdateUsageDescription": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
