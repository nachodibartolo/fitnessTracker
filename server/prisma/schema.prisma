generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// USUARIOS
// =====================================================================

/// Login propio: email + contraseña. Se guarda solo el hash (scrypt) de la
/// contraseña, nunca el texto plano. Cada login abre una AuthSession cuyo
/// token viaja en el header `Authorization: Bearer <token>`.
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String?    @unique
  passwordHash       String?
  name               String?
  timezone           String     @default("America/Argentina/Buenos_Aires")
  weightUnit         WeightUnit @default(KG)
  heightCm           Float?
  birthDate          DateTime?  @db.Date
  dailyKcalTarget    Int?
  dailyProteinTarget Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  healthImports    HealthImport[]
  healthSamples    HealthSample[]
  workouts         Workout[]
  dailySummaries   DailyHealthSummary[]
  meals            Meal[]
  authSessions     AuthSession[]
}

enum WeightUnit {
  KG
  LB
}

/// Una fila por sesión abierta (login). El token es aleatorio y se borra
/// al hacer logout; si expiró, el middleware la rechaza.
model AuthSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// =====================================================================
// SALUD (Apple Health)
// =====================================================================
//
// Modelo híbrido: lo crudo (FC minuto a minuto, pasos por intervalo, etapas
// de sueño) se queda en el teléfono / HealthKit. Al servidor sube solo:
//   1. DailyHealthSummary → una fila por usuario y día. Tabla principal.
//   2. Workout            → cada entrenamiento que registró el reloj.
//   3. HealthSample       → métricas puntuales de pocas filas (peso, HRV, FC reposo).
//
// Hay UNA ruta de ingesta (ej. POST /health/sync) que recibe ese payload, y
// dos productores que la alimentan:
//   - hoy: el usuario sube export.xml, el servidor lo parsea en streaming,
//     acumula por día y descarta lo crudo.
//   - después: la app le pide a HealthKit las estadísticas por día (ya da
//     sumas y promedios) y manda el mismo payload.
// Para el resto del backend y para el agente no hay diferencia.

/// Registro de cada carga (export.xml subido, o sync desde HealthKit).
/// Un XML nuevo reemplaza al anterior: se borra el HealthImport viejo
/// (cascade → sus HealthSample) y los días y workouts se upsertean por
/// clave natural, así conservan sus ids entre cargas.
/// El canal HEALTHKIT es incremental: upsertea solo los días que cambiaron.
model HealthImport {
  id               String              @id @default(uuid(7)) @db.Uuid
  userId           String              @db.Uuid
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          HealthImportChannel
  status           ImportStatus        @default(PENDING)
  fileName         String?
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?
  rangeFrom        DateTime?           @db.Date
  rangeTo          DateTime?           @db.Date
  daysUpserted     Int                 @default(0)
  workoutsUpserted Int                 @default(0)
  samplesInserted  Int                 @default(0)
  error            String?

  days     DailyHealthSummary[]
  workouts Workout[]
  samples  HealthSample[]
}

enum HealthImportChannel {
  APPLE_HEALTH_XML /// export.xml subido a mano
  HEALTHKIT /// a futuro: sync directo desde el iPhone
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Una fila por usuario y día (en la timezone del usuario). Es lo que leen
/// el dashboard y las tools del agente. La calcula el productor (importer
/// del XML o la app con HealthKit); el servidor solo la upsertea.
model DailyHealthSummary {
  id       String        @id @default(uuid(7)) @db.Uuid
  userId   String        @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId String?       @db.Uuid
  import   HealthImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  date     DateTime      @db.Date

  // Actividad
  steps                Int?
  distanceKm           Float?
  flightsClimbed       Int?
  activeEnergyKcal     Float?
  basalEnergyKcal      Float?
  activeEnergyGoalKcal Float? /// del <ActivitySummary> (anillo Moverse)
  exerciseMin          Int?
  standHours           Int?

  // Cardio (agregados del día; el crudo no sube)
  restingHeartRate Int?
  avgHeartRate     Float?
  minHeartRate     Int?
  maxHeartRate     Int?
  hrvSdnnMs        Float?
  respiratoryRate  Float?
  oxygenSaturation Float? /// 0..1

  // Sueño de la noche que termina en este día (minutos por etapa)
  sleepStartedAt DateTime?
  sleepEndedAt   DateTime?
  sleepInBedMin  Int?
  sleepAsleepMin Int? /// core + deep + rem
  sleepCoreMin   Int?
  sleepDeepMin   Int?
  sleepRemMin    Int?
  sleepAwakeMin  Int?

  // Composición corporal (última medición del día)
  weightKg       Float?
  bodyFatPct     Float? /// 0..1
  leanBodyMassKg Float?

  // Entrenamientos del reloj ese día
  workoutCount Int @default(0)
  workoutMin   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

enum WorkoutType {
  TRADITIONAL_STRENGTH_TRAINING
  FUNCTIONAL_STRENGTH_TRAINING
  RUNNING
  WALKING
  CYCLING
  STAIR_CLIMBING
  SWIMMING
  HIIT
  OTHER
}

/// Un <Workout> de Apple Health: el reloj registró una actividad.
/// Se upsertea por (userId, sourceName, startedAt) en cada carga.
model Workout {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId         String?       @db.Uuid
  import           HealthImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  type             WorkoutType
  /// Identificador original de Apple, por si cae en OTHER.
  activityTypeRaw  String?
  startedAt        DateTime
  endedAt          DateTime
  durationMin      Float
  activeEnergyKcal Float?
  distanceKm       Float?
  avgHeartRate     Float?
  maxHeartRate     Int?
  isIndoor         Boolean?
  sourceName       String
  /// UUID del workout en HealthKit (solo con sync directo).
  externalId       String?

  @@unique([userId, sourceName, startedAt])
  @@index([userId, startedAt])
}

/// Solo métricas puntuales, de pocas filas (en tu export: ~110 pesos,
/// ~870 HRV, ~200 FC en reposo). Lo continuo (FC, pasos, energía, SpO2,
/// respiración, sueño) NUNCA sube como sample: va agregado por día.
/// Unidad canónica en el comentario; el importer convierte (lb → kg, etc.).
enum HealthMetric {
  BODY_MASS /// kg
  BODY_FAT_PERCENTAGE /// 0..1
  LEAN_BODY_MASS /// kg
  BODY_MASS_INDEX
  HEIGHT /// cm
  RESTING_HEART_RATE /// latidos/min
  HEART_RATE_VARIABILITY_SDNN /// ms
  VO2_MAX /// mL/kg/min
}

/// Una medición puntual. Sirve para graficar con más detalle que un día
/// (varias pesadas el mismo día, HRV por noche) y para cargas manuales.
model HealthSample {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId   String?       @db.Uuid
  import     HealthImport? @relation(fields: [importId], references: [id], onDelete: Cascade)
  metric     HealthMetric
  value      Float
  measuredAt DateTime
  /// Dispositivo/app de origen tal cual lo reporta Apple: "Zepp", "Nacho's iPhone",
  /// "Xiaomi Home", "Health". Para cargas desde la app: "manual".
  sourceName String
  /// UUID del sample en HealthKit (solo con sync directo).
  externalId String?

  /// Clave natural: re-importar el mismo export no duplica.
  @@unique([userId, metric, sourceName, measuredAt])
  @@index([userId, metric, measuredAt])
}

// =====================================================================
// COMIDA
// =====================================================================

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  AI_IMAGE /// la IA la completó a partir de una foto
  AI_TEXT /// la IA la completó a partir de una descripción escrita
}

/// Una comida. Los totales viven acá y son lo que el usuario ve y edita;
/// la IA los propone y el usuario confirma.
model Meal {
  id       String    @id @default(uuid(7)) @db.Uuid
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt  DateTime
  mealType MealType?
  name     String
  imageUrl String? /// URL de la foto (donde termine alojada)

  calories Float?
  proteinG Float?
  carbsG   Float?
  fiberG   Float?
  fatG     Float?

  source       MealSource @default(MANUAL)
  aiModel      String?
  aiConfidence Float? /// 0..1, lo que reporte el modelo
  aiRaw        Json? /// respuesta completa del modelo, por si hay que auditar

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MealItem[]

  @@index([userId, eatenAt])
}

/// Desglose opcional de una comida ("milanesa", "puré"). Lo devuelve
/// naturalmente la IA al analizar una foto; la app funciona sin esto.
model MealItem {
  id       String  @id @default(uuid(7)) @db.Uuid
  mealId   String  @db.Uuid
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  order    Int
  name     String
  quantity Float?
  unit     String? /// "g", "unidad", "taza"
  calories Float?
  proteinG Float?
  carbsG   Float?
  fiberG   Float?
  fatG     Float?

  @@unique([mealId, order])
}
