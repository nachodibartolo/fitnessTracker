# URL de la API. Simulador: localhost. Celular físico: IP local de la computadora.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Usuario provisorio (hasta que haya login): UUID que la app manda en el header x-user-id.
# Tiene que ser el mismo con el que se importaron los datos.
EXPO_PUBLIC_USER_ID=00000000-0000-0000-0000-000000000000
